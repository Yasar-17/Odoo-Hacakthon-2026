generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  userId        BigInt          @id @default(autoincrement()) @map("user_id")
  employeeId    String          @unique @map("employee_id") @db.VarChar(30)
  email         String          @unique @db.VarChar(255)
  passwordHash  String          @map("password_hash")
  emailVerified Boolean?        @default(false) @map("email_verified")
  isActive      Boolean?        @default(true) @map("is_active")
  createdAt     DateTime?       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime?       @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  audit_logs    audit_logs[]
  employee      Employee?
  notifications notifications[]
  userRoles     UserRole[]

  @@map("users")
}

model Role {
  roleId    Int        @id @default(autoincrement()) @map("role_id")
  roleName  String     @unique @map("role_name") @db.VarChar(30)
  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  userId BigInt @map("user_id")
  roleId Int    @map("role_id")
  role   Role   @relation(fields: [roleId], references: [roleId], onUpdate: NoAction)
  user   User   @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Department {
  departmentId   Int           @id @default(autoincrement()) @map("department_id")
  departmentName String        @unique @map("department_name") @db.VarChar(100)
  description    String?
  employees      Employee[]
  positions      JobPosition[]

  @@map("departments")
}

model JobPosition {
  positionId   Int         @id @default(autoincrement()) @map("position_id")
  positionName String      @map("position_name") @db.VarChar(100)
  departmentId Int?        @map("department_id")
  description  String?
  employees    Employee[]
  department   Department? @relation(fields: [departmentId], references: [departmentId], onUpdate: NoAction)

  @@map("job_positions")
}

model Employee {
  employeeId        BigInt             @id @default(autoincrement()) @map("employee_id")
  userId            BigInt?            @unique @map("user_id")
  firstName         String             @map("first_name") @db.VarChar(100)
  lastName          String?            @map("last_name") @db.VarChar(100)
  dateOfBirth       DateTime?          @map("date_of_birth") @db.Date
  gender            String?            @db.VarChar(20)
  phone             String?            @db.VarChar(20)
  address           String?
  departmentId      Int?               @map("department_id")
  positionId        Int?               @map("position_id")
  joiningDate       DateTime?          @map("joining_date") @db.Date
  employmentStatus  String?            @default("ACTIVE") @map("employment_status") @db.VarChar(30)
  profilePictureUrl String?            @map("profile_picture_url")
  createdAt         DateTime?          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime?          @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  attendance        Attendance[]
  documents         EmployeeDocument[]
  department        Department?        @relation(fields: [departmentId], references: [departmentId], onUpdate: NoAction)
  position          JobPosition?       @relation(fields: [positionId], references: [positionId], onUpdate: NoAction)
  user              User?              @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: NoAction)
  leaveApprovals    LeaveApproval[]    @relation("ApprovedBy")
  leaveRequests     LeaveRequest[]
  payroll_records   payroll_records[]
  salaryStructures  SalaryStructure[]

  @@map("employees")
}

model EmployeeDocument {
  documentId   BigInt    @id @default(autoincrement()) @map("document_id")
  employeeId   BigInt    @map("employee_id")
  documentType String    @map("document_type") @db.VarChar(50)
  documentName String    @map("document_name") @db.VarChar(255)
  documentUrl  String    @map("document_url")
  uploadedAt   DateTime? @default(now()) @map("uploaded_at") @db.Timestamp(6)
  employee     Employee  @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade, onUpdate: NoAction)

  @@map("employee_documents")
}

model Attendance {
  attendanceId   BigInt    @id @default(autoincrement()) @map("attendance_id")
  employeeId     BigInt    @map("employee_id")
  attendanceDate DateTime  @map("attendance_date") @db.Date
  checkIn        DateTime? @map("check_in") @db.Timestamp(6)
  checkOut       DateTime? @map("check_out") @db.Timestamp(6)
  status         String    @db.VarChar(20)
  totalHours     Decimal?  @map("total_hours") @db.Decimal(5, 2)
  remarks        String?
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  employee       Employee  @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([employeeId, attendanceDate])
  @@map("attendance")
}

model LeaveType {
  leaveTypeId Int            @id @default(autoincrement()) @map("leave_type_id")
  typeName    String         @unique @map("type_name") @db.VarChar(50)
  description String?
  requests    LeaveRequest[]

  @@map("leave_types")
}

model LeaveRequest {
  leaveRequestId BigInt          @id @default(autoincrement()) @map("leave_request_id")
  employeeId     BigInt          @map("employee_id")
  leaveTypeId    Int             @map("leave_type_id")
  startDate      DateTime        @map("start_date") @db.Date
  endDate        DateTime        @map("end_date") @db.Date
  reason         String?
  status         String?         @default("PENDING") @db.VarChar(20)
  appliedAt      DateTime?       @default(now()) @map("applied_at") @db.Timestamp(6)
  approvals      LeaveApproval[]
  employee       Employee        @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade, onUpdate: NoAction)
  leaveType      LeaveType       @relation(fields: [leaveTypeId], references: [leaveTypeId], onUpdate: NoAction)

  @@map("leave_requests")
}

model LeaveApproval {
  approvalId     BigInt       @id @default(autoincrement()) @map("approval_id")
  leaveRequestId BigInt       @map("leave_request_id")
  approvedBy     BigInt       @map("approved_by")
  decision       String       @db.VarChar(20)
  comments       String?
  decidedAt      DateTime?    @default(now()) @map("decided_at") @db.Timestamp(6)
  approver       Employee     @relation("ApprovedBy", fields: [approvedBy], references: [employeeId], onUpdate: NoAction)
  leaveRequest   LeaveRequest @relation(fields: [leaveRequestId], references: [leaveRequestId], onDelete: Cascade, onUpdate: NoAction)

  @@map("leave_approvals")
}

model SalaryStructure {
  salaryId        BigInt            @id @default(autoincrement()) @map("salary_id")
  employeeId      BigInt            @map("employee_id")
  basicSalary     Decimal           @map("basic_salary") @db.Decimal(12, 2)
  hra             Decimal?          @default(0) @db.Decimal(12, 2)
  allowances      Decimal?          @default(0) @db.Decimal(12, 2)
  deductions      Decimal?          @default(0) @db.Decimal(12, 2)
  effectiveFrom   DateTime          @map("effective_from") @db.Date
  effectiveTo     DateTime?         @map("effective_to") @db.Date
  createdAt       DateTime?         @default(now()) @map("created_at") @db.Timestamp(6)
  payroll_records payroll_records[]
  employee        Employee          @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade, onUpdate: NoAction)

  @@map("salary_structures")
}

model audit_logs {
  audit_id   BigInt    @id @default(autoincrement())
  user_id    BigInt?
  action     String    @db.VarChar(100)
  table_name String?   @db.VarChar(100)
  record_id  BigInt?
  old_data   Json?
  new_data   Json?
  created_at DateTime? @default(now()) @db.Timestamp(6)
  users      User?     @relation(fields: [user_id], references: [userId], onUpdate: NoAction)
}

model notifications {
  notification_id   BigInt    @id @default(autoincrement())
  user_id           BigInt
  title             String    @db.VarChar(255)
  message           String
  notification_type String?   @db.VarChar(50)
  is_read           Boolean?  @default(false)
  created_at        DateTime? @default(now()) @db.Timestamp(6)
  users             User      @relation(fields: [user_id], references: [userId], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model payroll_records {
  payroll_id        BigInt           @id @default(autoincrement())
  employee_id       BigInt
  salary_id         BigInt?
  payroll_month     DateTime         @db.Date
  gross_salary      Decimal          @db.Decimal(12, 2)
  total_deductions  Decimal?         @default(0) @db.Decimal(12, 2)
  net_salary        Decimal          @db.Decimal(12, 2)
  payment_status    String?          @default("PENDING") @db.VarChar(30)
  generated_at      DateTime?        @default(now()) @db.Timestamp(6)
  employees         Employee         @relation(fields: [employee_id], references: [employeeId], onDelete: Cascade, onUpdate: NoAction)
  salary_structures SalaryStructure? @relation(fields: [salary_id], references: [salaryId], onUpdate: NoAction)

  @@unique([employee_id, payroll_month])
}
